# Resend API key (https://resend.com/api-keys). Needs "Sending access" and "Full access" is not required
# beyond contacts; use a key allowed to send from emails.yavqo.com and manage contacts.
RESEND_API_KEY=

# Sender. The domain emails.yavqo.com must be verified in Resend.
EMAIL_FROM="Saturn <noreply@emails.yavqo.com>"

# Public URL of the site, used for links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:4173

# Long random string used to sign unsubscribe links. Generate with: openssl rand -hex 32
# Changing it invalidates every unsubscribe link already sent.
UNSUBSCRIBE_SECRET=

# Inbox that receives messages from the Contact page.
CONTACT_TO_EMAIL=
